# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_telegram_chat_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Optional small model for product/scene request profile parsing.
# Leave empty to reuse OPENAI_* settings. Recommended for DashScope/Qwen:
# PROFILE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PROFILE_LLM_MODEL=qwen3.6-flash
PROFILE_LLM_PROVIDER=
PROFILE_LLM_API_KEY=
PROFILE_LLM_BASE_URL=
PROFILE_LLM_MODEL=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cs_agent

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
